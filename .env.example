# ---------- Required by /api/cron/sync-ipos (put these in .env.local for local runs, and in Vercel -> Settings -> Environment Variables) ----------

# Neon pooled connection string. Must end with ?sslmode=require (delete &channel_binding=require if present)
DATABASE_URL=

# ipoalerts.in API key (sent as the x-api-key header)
IPO_ALERTS_API_KEY=

# Google Gemini API key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# A long random string you invent (for example the output of: openssl rand -hex 32).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>". The endpoint refuses everything else.
CRON_SECRET=

# ---------- Optional (defaults shown) ----------

# Which AI writes the research: gemini (default) or claude
# AI_PROVIDER=gemini

# Gemini model. Google changes which models are free; if you see "model not found", pick another from AI Studio.
# GEMINI_MODEL=gemini-3.5-flash-lite

# IMPORTANT: Google's FREE Gemini tier has no web search. In that mode the AI only restates the data ipoalerts supplies,
# writes "Not disclosed in sources found" for financials, and the rating and verdict are left EMPTY (null) on purpose.
# Set this to true only on a billed Google project, to let Gemini search the web and produce a rating.
# GEMINI_USE_SEARCH=false

# Only if AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Re-run AI research for an IPO only when its research is older than this many hours
# RESEARCH_TTL_HOURS=72

# At most this many IPOs get AI research per run (default 8 for gemini, 3 for claude)
# MAX_RESEARCH_PER_RUN=8

# Web searches Claude may run per IPO (Claude only)
# MAX_WEB_SEARCHES_PER_IPO=6

# Ask ipoalerts for GMP data. Needs their Pro plan with the GMP add-on; leave unset otherwise.
# IPO_ALERTS_INCLUDE_GMP=true

# Seconds the run may use before it stops starting new research (default: function limit minus 40)
# SYNC_TIME_BUDGET_SECONDS=
