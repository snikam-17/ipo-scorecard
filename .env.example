# Postgres connection. If unset, the site runs on the built-in DEMO seed data.
DATABASE_URL=postgres://user:password@localhost:5432/ipo_rating

# IPO data API used by `npm run ingest`.
# The endpoint must return JSON (array of IPO records, or { data: [...] }).
# Map the vendor's fields to the Ipo type in lib/providers/generic-json.ts (normalize()).
IPO_API_URL=
IPO_API_KEY=
# Header used to send the key (default: Authorization: Bearer <key>)
IPO_API_KEY_HEADER=Authorization
